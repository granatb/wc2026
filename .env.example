# Copy to .env and fill in. Never commit real keys.
# The Odds API — https://the-odds-api.com  (match odds + player props)
ODDS_API_KEY=

# API-Sports / api-football — https://www.api-football.com  (schedule + lineups)
API_FOOTBALL_KEY=

# Reddit — read-only official API (app-only OAuth, no password needed).
# Register a "script" app at https://www.reddit.com/prefs/apps, then paste the
# client id (under the app name) and secret here. Never committed: .env is
# gitignored. Read paths only — core/reddit.py has no write capability.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
